# Variables de entorno para la demo — solo NOMBRES, nunca valores reales.
# Copiar a .env y rellenar antes de docker compose up.
# Los defaults del compose son suficientes para una demo local con USE_FAKE_ENGINE=1.

ANTHROPIC_API_KEY=
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=
DOCKER_REGISTRY=
IMAGE_TAG=latest
LLAMAINDEX_DATABASE_URL=
NAMESPACE=demo
OPENAI_API_KEY=
POSTGRES_DB=banco
POSTGRES_PASSWORD=
POSTGRES_USER=
